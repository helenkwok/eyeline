server {
    listen       ${PORT};
    listen  [::]:${PORT};
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    # Ensure range requests are fully supported for HTML5 video seeking
    max_ranges 512;

    # Performance
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss text/javascript image/svg+xml;

    # Security & CORS headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;

    # Main On-Set Review Station UI
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Clean judge portal URL
    location = /judge {
        try_files /judge.html =404;
    }

    # Static assets (MP4 clips, fixtures, schemas)
    location /bench/ {
        alias /usr/share/nginx/html/bench/;
        autoindex off;
    }

    # Video streaming cache headers
    location ~* \.(mp4)$ {
        add_header Cache-Control "public, max-age=86400";
        add_header Accept-Ranges bytes;
    }

    # Error handling
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
