# Environments & dependencies
.venv/
node_modules/

# Python cache
__pycache__/
*.pyc

# Local secrets & credentials (strictly avoided)
.env
*.key
*.pem

# Bob local state / cache (keep tracked configuration)
.bob/*.db
.bob/logs/
.bob/*.tmp

# Media binaries (test/benchmark footage)
bench/media/*.mp4
bench/media/*.png
!bench/media/.gitkeep

# System & transcripts
.DS_Store
.bob-transcripts/*.raw
